{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsustain.example/schemas/common.schema.json",
  "$defs": {
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version",
        "source"
      ],
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "quantified",
            "unquantified",
            "not_applicable"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "description",
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "quantified"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "unit": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "calculation": {
      "type": "object",
      "properties": {
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "conversions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "rounding": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "formula",
        "inputs",
        "conversions",
        "rounding"
      ],
      "additionalProperties": false
    },
    "review_requirement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "PROFESSIONAL_REVIEW_REQUIRED",
            "LEGAL_REVIEW_REQUIRED",
            "ASSURANCE_REQUIRED",
            "ENGINEERING_REVIEW_REQUIRED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_role": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolution": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "decision": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "reviewer",
                "role",
                "decision",
                "scope",
                "date",
                "evidence_ids"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "state",
        "reason",
        "scope",
        "reviewer_role",
        "status",
        "resolution"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            }
          },
          "then": {
            "properties": {
              "resolution": {
                "type": "object",
                "properties": {
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "reviewer",
                  "role",
                  "decision",
                  "scope",
                  "date",
                  "evidence_ids"
                ],
                "additionalProperties": false
              }
            }
          },
          "else": {
            "properties": {
              "resolution": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "gap": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "remedy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "field",
        "reason",
        "impact",
        "remedy"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "$ref": "common.schema.json#/$defs/period"
        },
        "boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "method": {
          "$ref": "common.schema.json#/$defs/method"
        },
        "assumption": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "uncertainty": {
          "$ref": "common.schema.json#/$defs/uncertainty"
        },
        "calculation": {
          "$ref": "common.schema.json#/$defs/calculation"
        }
      },
      "required": [
        "id",
        "name",
        "value",
        "unit",
        "period",
        "boundary_id",
        "evidence_ids",
        "method",
        "assumption",
        "uncertainty",
        "calculation"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "attributes": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "evidence_ids",
        "attributes"
      ],
      "additionalProperties": false
    },
    "review_state": {
      "enum": [
        "ADVISORY",
        "ANALYTICAL",
        "EVIDENCE_INCOMPLETE",
        "PROFESSIONAL_REVIEW_REQUIRED",
        "LEGAL_REVIEW_REQUIRED",
        "ASSURANCE_REQUIRED",
        "ENGINEERING_REVIEW_REQUIRED"
      ]
    }
  }
}
