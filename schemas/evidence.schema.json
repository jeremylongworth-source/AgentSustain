{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsustain.example/schemas/evidence.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "accessed": {
          "type": "string",
          "format": "date"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "locator",
        "title",
        "publisher",
        "accessed",
        "version",
        "tier"
      ],
      "additionalProperties": false
    },
    "method": {
      "$ref": "common.schema.json#/$defs/method"
    },
    "period": {
      "$ref": "common.schema.json#/$defs/period"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "boundary_id": {
      "type": "string",
      "minLength": 1
    },
    "geography": {
      "type": "string",
      "minLength": 1
    },
    "quality": {
      "type": "object",
      "properties": {
        "reliability": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "fitness_notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reliability",
        "completeness",
        "fitness_notes"
      ],
      "additionalProperties": false
    },
    "assumption": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "uncertainty": {
      "$ref": "common.schema.json#/$defs/uncertainty"
    },
    "calculation": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/calculation"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "source",
    "method",
    "period",
    "unit",
    "boundary_id",
    "geography",
    "quality",
    "assumption",
    "uncertainty",
    "calculation"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "tier": {
                "const": 5
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assumption": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
